<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.baccan</groupId>
    <artifactId>vmjms</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <name>vmjms</name>
    <description>In-Memory JMS Provider compliant with Jakarta JMS 3.x</description>
    <url>https://github.com/matteobaccan/vmjms</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>matteobaccan</id>
            <name>Matteo Baccan</name>
            <url>https://github.com/matteobaccan</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/matteobaccan/vmjms.git</connection>
        <developerConnection>scm:git:git@github.com:matteobaccan/vmjms.git</developerConnection>
        <url>https://github.com/matteobaccan/vmjms</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/matteobaccan/vmjms/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakarta.jms.version>3.1.0</jakarta.jms.version>
        <junit.version>5.10.1</junit.version>
    </properties>

    <dependencies>
        <!-- Jakarta JMS API -->
        <dependency>
            <groupId>jakarta.jms</groupId>
            <artifactId>jakarta.jms-api</artifactId>
            <version>${jakarta.jms.version}</version>
        </dependency>

        <!-- JUnit 5 for Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <!--
                        release, not source/target: with source/target the compiler links
                        against the api of whichever jdk runs the build, so building on 21
                        can produce a class file marked 17 that calls a method only 21 has
                        and fails at runtime. release pins the api too.
                    -->
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <!--
                        Syntax, references and tag consistency are enforced and a warning
                        fails the build, so the published javadoc cannot rot unnoticed.
                        The missing group is off on purpose: 196 of the 270 public members
                        implement a jakarta.jms interface whose contract is the
                        specification, and the api jar carries no sources for javadoc to
                        inherit from, so requiring a comment on each would buy noise. What
                        those methods need is their deviations documented, which the class
                        javadoc does.
                    -->
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <notimestamp>true</notimestamp>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activated for Maven Central publication: signs every artifact with GPG
             and uploads the bundle to the Central Portal. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
